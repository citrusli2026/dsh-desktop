{
  "name": "dsh-electron-shell",
  "version": "0.1.1-pre.0",
  "description": "Unofficial DeepSeek Harness Electron desktop shell: download and use; identical to `dsh web`",
  "author": "dsh-electron-shell contributors <citrusli@126.com>",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citrusli2026/dsh-electron-shell.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/main/index.cjs",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "smoke": "pnpm run build && electron . --smoke-test",
    "gen-icons": "node scripts/gen-icons.mjs",
    "fetch-node": "node scripts/fetch-node.mjs",
    "deploy-harness": "node scripts/deploy-harness.mjs",
    "bootstrap": "pnpm run deploy-harness && pnpm run fetch-node",
    "postinstall": "node scripts/install-electron.mjs",
    "dist": "pnpm run build && electron-builder",
    "dist:dir": "pnpm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.0",
    "extract-zip": "^2.0.1",
    "sharp": "^0.35.3",
    "tar": "^7.0.0",
    "typescript": "^7.0.0"
  }
}
