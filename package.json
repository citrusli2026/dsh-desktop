{
  "name": "dsh-desktop",
  "version": "0.1.0-rc.6.shell.17",
  "description": "Unofficial DeepSeek Harness Electron desktop shell: download and use; identical to `dsh web`",
  "author": "dsh-desktop contributors <citrusli@126.com>",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citrusli2026/dsh-electron-shell.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "main": "lib/main/index.cjs",
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "dsh-validate-release": "./bin/dsh-validate-release.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=70 \"test/**/*.test.ts\"",
    "test:e2e": "pnpm run build && playwright test",
    "site:check": "node --check site/assets/app.js && node scripts/check-site.mjs && node scripts/check-api-downloads.mjs",
    "verify": "pnpm run typecheck && pnpm run test:coverage && pnpm run site:check && pnpm run build",
    "security:audit": "pnpm --registry=https://registry.npmjs.org audit && pnpm --dir manifest/harness --registry=https://registry.npmjs.org audit --prod",
    "release:check-assets": "node scripts/check-release-assets.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "smoke": "pnpm run build && electron . --smoke-test",
    "gen-icons": "node scripts/gen-icons.mjs",
    "fetch-node": "node scripts/fetch-node.mjs",
    "deploy-harness": "node scripts/deploy-harness.mjs",
    "bootstrap": "pnpm run deploy-harness && pnpm run fetch-node",
    "postinstall": "node scripts/install-electron.mjs",
    "dist": "pnpm run build && electron-builder",
    "dist:dir": "pnpm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tar": "^7.0.0",
    "typescript": "^7.0.0"
  }
}
